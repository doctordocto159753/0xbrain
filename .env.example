# Template. install.sh writes the real .env (git-ignored, mode 600). Never commit it.
BRAIN_DOMAIN=brain.example.com
BRAIN_OWNER_EMAIL=you@example.com
BRAIN_PREFIX=zb
BRAIN_WIKI_NAME=My Brain

# Paths (absolute)
BRAIN_DATA_DIR=/opt/0xbrain/wiki
BRAIN_STATE_DIR=/var/lib/0xbrain
BRAIN_UID=1000
BRAIN_GID=1000

# TLS: empty = public ACME (Let's Encrypt). "tls internal" = self-signed, disposable tests only.
BRAIN_TLS_DIRECTIVE=
BRAIN_HTTP_PORT=80
BRAIN_HTTPS_PORT=443

# Auth transport seam (see docs/deploy/AUTH_TRANSPORT_SEAM.md). Provisional until Agent A's choice is integrated.
BRAIN_PUBLIC_URL=https://brain.example.com
BRAIN_SECRET_KEY=generated-by-install.sh
BRAIN_OWNER_SETUP_TOKEN=generated-by-install.sh
# Optional external IdP (only with an auth domain):
# BRAIN_AUTH_DOMAIN=auth.example.com
# BRAIN_AUTH_IMAGE=
# BRAIN_AUTH_PORT=1411
# COMPOSE_PROFILES=auth

# Server command override (default: auto-detect brain_server/ or scripts/brain_mcp/).
# BRAIN_SERVER_CMD=python -m brain_server
# Deployment-plumbing tests only; never for a real install:
# BRAIN_ALLOW_STUB=1
