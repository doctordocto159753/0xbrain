# Template. install.sh writes the real .env (git-ignored, mode 600). Never commit it.
BRAIN_DOMAIN=brain.example.com
BRAIN_OWNER_EMAIL=you@example.com
BRAIN_PREFIX=zb
BRAIN_WIKI_NAME=My Brain

# Paths (absolute, host side)
BRAIN_DATA_DIR=/opt/0xbrain/wiki
# Host state root: <root>/auth (OAuth state, mounted as the server's
# BRAIN_STATE_DIR), <root>/qmd (rebuildable index), <root>/caddy, <root>/backups.
BRAIN_STATE_DIR=/var/lib/0xbrain
BRAIN_UID=1000
BRAIN_GID=1000

# TLS: empty = public ACME (Let's Encrypt). "tls internal" = self-signed, disposable tests only.
BRAIN_TLS_DIRECTIVE=
BRAIN_HTTP_PORT=80
BRAIN_HTTPS_PORT=443

# Remote MCP + single-owner OAuth (scripts/remote_mcp/server.py)
BRAIN_PUBLIC_URL=https://brain.example.com
# Owner passphrase typed on the consent page when Claude connects (>= 16 chars).
BRAIN_OWNER_SECRET=generated-by-install.sh
# Optional: exact extra redirect URIs, comma separated (no wildcards). Default:
# https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# BRAIN_ALLOWED_REDIRECTS=

# Git identity for the server's noncanonical commits (K9)
# BRAIN_GIT_NAME=0xBrain
# BRAIN_GIT_EMAIL=brain@localhost

# Deployment-plumbing tests only; never for a real install (health-only, no MCP):
# BRAIN_ALLOW_STUB=1
