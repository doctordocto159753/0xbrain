{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Living Wiki capture record front matter (1.2.0, schema 1.0.0)",
  "description": "Reference shape for cap-* front matter. The enforcing validator is validate_record() in scripts/capture/wiki_capture.py; this file documents the contract for clients.",
  "type": "object",
  "required": ["id", "type", "title", "status", "capture_kind", "captured_at", "capture_channel", "language_hint", "raw_media_available", "sha256", "bytes", "duplicate_of", "transcription_state", "transcription_reviewed", "quality_flags", "promoted_to", "schema_version"],
  "properties": {
    "id": {"type": "string", "pattern": "^cap-[0-9]{8}-[0-9]{6}-[0-9a-f]{4}$"},
    "type": {"const": "capture"},
    "title": {"type": "string", "pattern": "^Capture cap-"},
    "status": {"enum": ["received", "processing", "transcribed", "described", "needs-review", "processing-failed", "reviewed", "parked", "promoted"]},
    "capture_kind": {"enum": ["text", "voice", "handwriting", "drawing", "image", "file", "mixed"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "capture_channel": {"enum": ["telegram-hermes", "claude-mobile", "obsidian", "mcp", "filesystem"]},
    "language_hint": {"enum": ["fa", "en", "mixed", "unknown"]},
    "raw_media": {"type": ["string", "null"]},
    "raw_media_available": {"type": "boolean"},
    "sha256": {"type": ["string", "null"], "pattern": "^([0-9a-f]{64})$"},
    "bytes": {"type": ["integer", "null"], "minimum": 0},
    "duplicate_of": {"type": ["string", "null"]},
    "transcription_state": {"enum": ["not-requested", "pending", "complete", "needs-review", "failed"]},
    "transcription_method": {"type": ["string", "null"]},
    "transcription_version": {"type": ["string", "null"]},
    "transcription_reviewed": {"type": "boolean"},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "promoted_to": {"type": ["string", "null"]},
    "schema_version": {"const": "1.0.0"},
    "interpretation_needs": {"type": "array", "items": {"enum": ["needs_transcription", "needs_description", "needs_interpretation"]}, "description": "OPTIONAL (K4, additive). Snapshot of open gaps; readers should prefer interpretation_gaps() which also covers legacy records."},
    "derivative_methods": {"type": "array", "items": {"type": "string", "pattern": "^(literal|description|interpretation):[A-Za-z0-9._-]+$"}, "description": "OPTIONAL (K4). One layer:method entry per derivative layer, e.g. literal:claude."},
    "derivative_tier": {"const": "candidate", "description": "OPTIONAL (K4). Present once any derivative exists; derivatives are never canonical and never implicitly human-reviewed."}
  },
  "note": "Forward-compatible migration: unknown fields are ignored by readers; schema_version bumps only on breaking change; validators reject unknown schema_version."
}
