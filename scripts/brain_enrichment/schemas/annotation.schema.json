{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CONTRACT-E1 annotation (candidate metadata; model-produced)",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 800},
    "topics": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "tags": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "categories": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "message_role": {"type": "string", "enum": ["idea", "question", "observation", "decision-proposal", "correction", "reference", "task", "other"]},
    "entities": {"type": "array", "maxItems": 10, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind", "mention"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"type": "string", "enum": ["concept", "person", "project", "organization", "work", "place", "other"]},
        "aliases": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "mention": {"type": "object", "additionalProperties": false, "required": ["chunk_ref", "text"],
          "properties": {"chunk_ref": {"type": "string", "pattern": "^chk:[0-9a-f]{32}$"},
                         "text": {"type": "string", "minLength": 1, "maxLength": 200}}}}}},
    "links": {"type": "array", "maxItems": 10, "items": {
      "type": "object", "additionalProperties": false, "required": ["relation", "target", "evidence"],
      "properties": {
        "relation": {"type": "string", "enum": ["about", "mentions", "part_of_project", "related_to", "supports", "contradicts"]},
        "target": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["source_ref"],
           "properties": {"source_ref": {"type": "string", "pattern": "^(rec|doc|cap):[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}}},
          {"type": "object", "additionalProperties": false, "required": ["entity"],
           "properties": {"entity": {"type": "string", "minLength": 1, "maxLength": 200}}},
          {"type": "object", "additionalProperties": false, "required": ["entity_id"],
           "properties": {"entity_id": {"type": "string", "pattern": "^ent:[0-9a-f]{24}$"}}}]},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false, "required": ["chunk_ref", "quote"],
          "properties": {"chunk_ref": {"type": "string", "pattern": "^chk:[0-9a-f]{32}$"},
                         "quote": {"type": "string", "minLength": 8, "maxLength": 500}}}},
        "note": {"type": "string", "maxLength": 300}}}},
    "chunk_annotations": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["chunk_ref"],
      "properties": {
        "chunk_ref": {"type": "string", "pattern": "^chk:[0-9a-f]{32}$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 300},
        "topics": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "tags": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 64}}}}},
    "uncertainty": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "producer_reported": {"type": "object", "additionalProperties": false,
      "properties": {"harness": {"type": "string", "maxLength": 80},
                     "model": {"type": "string", "maxLength": 80},
                     "prompt_version": {"type": "string", "maxLength": 80}}}
  }
}
