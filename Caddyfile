# Everything on the brain domain goes to the brain server, unfiltered: the
# remote MCP endpoint (/mcp), OAuth discovery (/.well-known/*), /register,
# /authorize, /token, /revoke, the owner consent form (/owner/login) and
# /healthz. The brain server authenticates /mcp itself (fail-closed).
# Env values come from .env. BRAIN_TLS_DIRECTIVE is empty (public ACME) or
# "tls internal" (disposable tests only).
{
	email {$BRAIN_OWNER_EMAIL}
}

{$BRAIN_DOMAIN} {
	{$BRAIN_TLS_DIRECTIVE}
	reverse_proxy brain:8080 {
		flush_interval -1
	}
}
